load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")
load("@rules_pkg//pkg:install.bzl", "pkg_install")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes", "pkg_filegroup", "pkg_files", "strip_prefix")

package(default_visibility = ["//visibility:public"])

exports_files(["CPPLINT.cfg"])

alias(
    name = "component",
    actual = "//:libmicrophone_component.so",
)

MICROPHONE_COPTS = ['-DMODULE_NAME=\\"microphone\\"']

cc_binary(
    name = "libmicrophone_component.so",
    linkshared = True,
    linkstatic = False,
    deps = [
        ":microphone_component_lib",
    ],
)

pkg_files(
    name = "package_files_data",
    srcs = [":runtime_data"],
    attributes = pkg_attributes(mode = "0644"),
    prefix = "drivers/addition_data/microphone",
    strip_prefix = strip_prefix.from_root(""),
)

pkg_files(
    name = "package_files_libraries",
    srcs = [":libmicrophone_component.so"],
    attributes = pkg_attributes(mode = "0755"),
    prefix = "drivers/lib/microphone",
    strip_prefix = strip_prefix.from_root(""),
)

pkg_filegroup(
    name = "package_files",
    srcs = [
        ":package_files_data",
        ":package_files_libraries",
        ":package_lib_top_level",
    ],
)

pkg_install(
    name = "install_dir",
    srcs = [":package_files"],
    tags = ["manual"],
)

pkg_files(
    name = "package_lib_top_level_libraries",
    srcs = [":libmicrophone_component.so"],
    attributes = pkg_attributes(mode = "0755"),
    prefix = "drivers/lib",
    strip_prefix = strip_prefix.from_root(""),
)

pkg_filegroup(
    name = "package_lib_top_level",
    srcs = [":package_lib_top_level_libraries"],
)

filegroup(
    name = "runtime_data",
    srcs = glob([
        "conf/*.txt",
        "dag/*.dag",
        "launch/*.launch",
    ]),
)

cc_library(
    name = "microphone_component_lib",
    srcs = ["microphone_component.cc"],
    hdrs = ["microphone_component.h"],
    copts = MICROPHONE_COPTS,
    include_prefix = "modules/drivers/microphone",
    strip_include_prefix = "/",
    deps = [
        ":audio_assembler",
        "//:respeaker",
        "//proto:audio_cc_proto",
        "//proto:microphone_config_cc_proto",
        "@core//cyber",
        "@wheelos_common//modules/common/util:util_tool",
    ],
    alwayslink = True,
)

cc_library(
    name = "respeaker",
    srcs = ["respeaker.cc"],
    hdrs = ["respeaker.h"],
    copts = MICROPHONE_COPTS,
    include_prefix = "modules/drivers/microphone",
    strip_include_prefix = "/",
    deps = [
        "//proto:microphone_config_cc_proto",
        "@core//cyber",
        "@portaudio",
    ],
)

cc_library(
    name = "audio_assembler",
    srcs = ["audio_assembler.cc"],
    hdrs = ["audio_assembler.h"],
    include_prefix = "modules/drivers/microphone",
    strip_include_prefix = "/",
    deps = [
        "//proto:audio_cc_proto",
        "//proto:microphone_config_cc_proto",
        "@core//cyber",
    ],
)

cc_test(
    name = "audio_assembler_test",
    size = "small",
    srcs = ["audio_assembler_test.cc"],
    deps = [
        ":audio_assembler",
        "@com_google_googletest//:gtest_main",
    ],
)
