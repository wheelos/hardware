common --enable_bzlmod
common --registry=https://bcr.wheelos.cn/
common --registry=https://bcr.bazel.build/
common --repository_cache=/apollo/.cache/bazel/repo_cache
build --disk_cache=/apollo/.cache/bazel/disk_cache
build --symlink_prefix=/
build --cxxopt=-std=c++17
test --test_output=errors
try-import %workspace%/.bazelrc.dev
