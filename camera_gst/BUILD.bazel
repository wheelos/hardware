load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")
load("@rules_pkg//pkg:install.bzl", "pkg_install")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes", "pkg_filegroup", "pkg_files", "strip_prefix")

package(default_visibility = ["//visibility:public"])

CAMERA_GST_COPTS = ['-DMODULE_NAME=\\"camera_gst\\"']

cc_library(
    name = "camera_gst_frame_extractor",
    srcs = ["frame_extractor.cc"],
    hdrs = [
        "frame_extractor.h",
        "frame_types.h",
    ],
    copts = CAMERA_GST_COPTS,
    include_prefix = "modules/drivers/camera_gst",
    strip_include_prefix = "/",
    deps = [
        "@core//cyber",
        "@gstreamer",
    ],
)

filegroup(
    name = "runtime_data",
    srcs = glob([
        "conf/**/*.txt",
        "dag/**/*.dag",
        "launch/**/*.launch",
    ]),
)

pkg_files(
    name = "package_files_data",
    srcs = [":runtime_data"],
    attributes = pkg_attributes(mode = "0644"),
    prefix = "drivers/addition_data/camera_gst",
    strip_prefix = strip_prefix.from_root(""),
)

pkg_files(
    name = "package_files_libraries",
    srcs = [":libcamera_gst_component.so"],
    attributes = pkg_attributes(mode = "0755"),
    prefix = "drivers/lib/camera_gst",
    strip_prefix = strip_prefix.from_root(""),
)

pkg_filegroup(
    name = "package_files",
    srcs = [
        ":package_files_data",
        ":package_files_libraries",
    ],
    target_compatible_with = ["@hardware.build//tools/platform:jetson_orin"],
)

pkg_install(
    name = "install_dir",
    srcs = [":package_files"],
    tags = ["manual"],
    target_compatible_with = ["@hardware.build//tools/platform:jetson_orin"],
)

cc_library(
    name = "camera_gst_core",
    srcs = [
        "camera_gst_driver.cc",
        "pipeline_builder.cc",
        "streamer.cc",
    ],
    hdrs = [
        "camera_gst_driver.h",
        "frame_types.h",
        "pipeline_builder.h",
        "streamer.h",
    ],
    copts = CAMERA_GST_COPTS,
    include_prefix = "modules/drivers/camera_gst",
    strip_include_prefix = "/",
    target_compatible_with = ["@hardware.build//tools/platform:jetson_orin"],
    deps = [
        ":camera_gst_frame_extractor",
        "//proto:config_cc_proto",
        "@core//cyber",
        "@gstreamer",
    ],
)

cc_library(
    name = "camera_gst_component_lib",
    srcs = ["camera_gst_component.cc"],
    hdrs = ["camera_gst_component.h"],
    copts = CAMERA_GST_COPTS,
    include_prefix = "modules/drivers/camera_gst",
    strip_include_prefix = "/",
    target_compatible_with = ["@hardware.build//tools/platform:jetson_orin"],
    deps = [
        ":camera_gst_core",
        "@core//cyber",
        "@gstreamer",
    ],
    alwayslink = True,
)

cc_binary(
    name = "libcamera_gst_component.so",
    linkshared = True,
    linkstatic = False,
    target_compatible_with = ["@hardware.build//tools/platform:jetson_orin"],
    deps = [":camera_gst_component_lib"],
)

cc_test(
    name = "streamer_test",
    size = "small",
    srcs = ["streamer_test.cc"],
    copts = CAMERA_GST_COPTS,
    target_compatible_with = ["@hardware.build//tools/platform:jetson_orin"],
    deps = [
        ":camera_gst_core",
        "@com_google_googletest//:gtest",
        "@core//cyber",
    ],
)

cc_test(
    name = "frame_extractor_test",
    size = "small",
    srcs = ["frame_extractor_test.cc"],
    copts = CAMERA_GST_COPTS,
    deps = [
        ":camera_gst_frame_extractor",
        "@com_google_googletest//:gtest",
        "@com_google_googletest//:gtest_main",
        "@core//cyber",
        "@gstreamer",
    ],
)

exports_files(["CPPLINT.cfg"])

alias(
    name = "component",
    actual = ":libcamera_gst_component.so",
)
