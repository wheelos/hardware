# Single V4L2 /dev/video0 camera GPU receive baseline. No Cyber image channel or stream.
module_config {
  module_library: "lib/components/hardware/libcamera_gst_component.so"

  components {
    class_name: "CameraGstComponent"
    config {
      name: "camera_gst_v4l2_device0_gpu"
      config_file_path: "conf/hardware/camera_gst/camera_gst_v4l2_device0_gpu.pb.txt"
    }
  }
}