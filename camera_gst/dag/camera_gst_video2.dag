# Define one camera_gst component for /dev/video2 benchmark.
module_config {
  module_library: "lib/components/hardware/libcamera_gst_component.so"

  components {
    class_name: "CameraGstComponent"
    config {
      name: "camera_gst_video2"
      config_file_path: "conf/hardware/camera_gst/camera_gst_video2.pb.txt"
    }
  }
}
