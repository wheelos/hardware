load("@core//runtime:install.bzl", "pkg_install")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes", "pkg_filegroup", "pkg_files", "strip_prefix")

package(default_visibility = ["//visibility:public"])

exports_files(["CPPLINT.cfg"])

alias(
    name = "client",
    actual = "//can_client",
)

alias(
    name = "factory",
    actual = "//can_client:can_client_factory",
)

alias(
    name = "tool",
    actual = "//can_client:can_client_tool",
)

pkg_files(
    name = "package_files_archives",
    srcs = [
        ":sensor_canbus_lib",
        ":sensor_gflags",
    ],
    attributes = pkg_attributes(mode = "0644"),
    prefix = "lib",
    strip_prefix = strip_prefix.from_root(""),
)

pkg_filegroup(
    name = "package_files",
    srcs = [":package_files_archives"],
    visibility = ["//visibility:public"],
)

pkg_install(
    name = "install_dir",
    srcs = [":package_files"],
    tags = ["manual"],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "sensor_gflags",
    srcs = ["sensor_gflags.cc"],
    hdrs = ["sensor_gflags.h"],
    include_prefix = "modules/drivers/canbus",
    strip_include_prefix = "/",
    deps = [
        "@com_github_gflags_gflags//:gflags",
    ],
    alwayslink = True,
)

cc_library(
    name = "sensor_canbus_lib",
    hdrs = ["sensor_canbus.h"],
    include_prefix = "modules/drivers/canbus",
    strip_include_prefix = "/",
    deps = [
        ":sensor_gflags",
        "//can_client:can_client_factory",
        "//can_comm:can_receiver",
        "//can_comm:can_sender",
        "//can_comm:message_manager_base",
        "//proto:sensor_canbus_conf_cc_proto",
        "@wheelos_common//modules/common/monitor_log",
    ],
    alwayslink = True,
)
