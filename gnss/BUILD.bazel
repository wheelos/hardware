load("@hardware.build//tools:cpplint.bzl", "cpplint")
load("@hardware.build//tools/install:install.bzl", "install")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")

package(default_visibility = ["//visibility:public"])

exports_files(["CPPLINT.cfg"])

alias(
    name = "component",
    actual = "//:libgnss_component.so",
)

GNSS_COPTS = ['-DMODULE_NAME=\\"gnss\\"']

cc_binary(
    name = "libgnss_component.so",
    linkshared = True,
    linkstatic = False,
    deps = [":gnss_component_lib"],
)

cc_library(
    name = "gnss_component_lib",
    srcs = ["gnss_component.cc"],
    hdrs = ["gnss_component.h"],
    copts = GNSS_COPTS,
    include_prefix = "modules/drivers/gnss",
    strip_include_prefix = "/",
    deps = [
        "//proto:gnss_status_cc_proto",
        "//stream:raw_stream",
        "@core//cyber",
        "@wheelos_common//modules/common/monitor_log",
        "@wheelos_msgs//wheelos_msgs/basic_msgs:drive_state_cc_proto",
        "@wheelos_msgs//wheelos_msgs/basic_msgs:vehicle_signal_cc_proto",
        "@wheelos_msgs//wheelos_msgs/chassis_msgs:chassis_cc_proto",
        "@wheelos_msgs//wheelos_msgs/config_msgs:vehicle_config_cc_proto",
        "@wheelos_msgs//wheelos_msgs/sensor_msgs:ins_cc_proto",
    ],
    alwayslink = True,
)

install(
    name = "install",
    data = [
        ":runtime_data",
    ],
    data_dest = "drivers/addition_data/gnss",
    library_dest = "drivers/lib/gnss",
    targets = [
        ":libgnss_component.so",
    ],
)

filegroup(
    name = "test_data_files",
    srcs = [
        "test_data/novatel.bin",
        "test_data/novatel_manifest.json",
    ],
)

filegroup(
    name = "profile_runtime_data",
    srcs = glob([
        "dag/*.dag",
        "launch/*.launch",
    ]),
)

filegroup(
    name = "runtime_data",
    srcs = glob([
        "conf/*.txt",
        "dag/*.dag",
        "launch/*.launch",
    ]),
)

cpplint()
