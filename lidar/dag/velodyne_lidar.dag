# Define all coms in DAG streaming.
module_config {                                             
  module_library : "lib/components/hardware/liblidar_driver_component.so"
  components {
    class_name : "LidarDriverComponent"
    config {
      name : "lidar_driver"
      config_file_path : "conf/hardware/lidar/lidar_config.pb.txt"
      readers {channel: "/apollo/sensor/lidar/driver"}
    }
  }
}

module_config {
    module_library : "lib/components/hardware/libvelodyne_convert_component.so"

    components {
      class_name : "VelodyneConvertComponent"
      config {
        name : "velodyne_convert"
        config_file_path : "conf/hardware/lidar/velodyne16_front_center_conf.pb.txt"
        readers {channel: "/apollo/sensor/lidar16/Scan"}
      }
    }
}

module_config {
    module_library : "lib/components/hardware/libvelodyne_compensator_component.so"

    components {
      class_name : "CompensatorComponent"
      config {
        name : "velodyne_compensator"
        config_file_path : "conf/hardware/lidar/velodyne16_fusion_compensator.pb.txt"
        readers {channel: "/apollo/sensor/lidar16/PointCloud2"}
      }
    }
}
