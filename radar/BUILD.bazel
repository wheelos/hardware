load("@hardware.build//tools:cpplint.bzl", "cpplint")
load("@hardware.build//tools/install:install.bzl", "install")
load("@rules_cc//cc:defs.bzl", "cc_test")

package(default_visibility = ["//visibility:public"])

exports_files(["CPPLINT.cfg"])

alias(
    name = "conti",
    actual = "//conti_radar:libconti_radar.so",
)

install(
    name = "install",
    deps = [
        "//conti_radar:install",
        "//racobit_radar:install",
        "//ultrasonic_radar:install",
    ],
)

cc_test(
    name = "radar_protocol_test",
    size = "small",
    srcs = ["radar_protocol_test.cc"],
    deps = [
        "//conti_radar/protocol:drivers_conti_radar_protocol",
        "//nano_radar/protocol:drivers_nano_radar_protocol",
        "//racobit_radar/protocol:drivers_racobit_radar_protocol",
        "//udas_ultrasonic_radar/protocol:canbus_udas_ultrasonic_radar_protocol",
        "//yg_radar/protocol:canbus_yg_radar_protocol",
        "@com_google_googletest//:gtest_main",
    ],
)

cpplint()
