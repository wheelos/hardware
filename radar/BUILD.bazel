load("@rules_cc//cc:defs.bzl", "cc_test")
load("@rules_pkg//pkg:install.bzl", "pkg_install")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes", "pkg_filegroup", "pkg_files", "strip_prefix")

package(default_visibility = ["//visibility:public"])

exports_files(["CPPLINT.cfg"])

alias(
    name = "conti",
    actual = "//conti_radar:libconti_radar.so",
)

pkg_filegroup(
    name = "package_files",
    srcs = [
        "//conti_radar:package_files",
        "//racobit_radar:package_files",
        "//ultrasonic_radar:package_files",
    ],
)

pkg_install(
    name = "install_dir",
    srcs = [":package_files"],
    tags = ["manual"],
)

cc_test(
    name = "radar_protocol_test",
    size = "small",
    srcs = ["radar_protocol_test.cc"],
    deps = [
        "//conti_radar/protocol:drivers_conti_radar_protocol",
        "//nano_radar/protocol:drivers_nano_radar_protocol",
        "//racobit_radar/protocol:drivers_racobit_radar_protocol",
        "//udas_ultrasonic_radar/protocol:canbus_udas_ultrasonic_radar_protocol",
        "//yg_radar/protocol:canbus_yg_radar_protocol",
        "@com_google_googletest//:gtest_main",
    ],
)
