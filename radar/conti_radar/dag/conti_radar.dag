module_config {
    module_library : "lib/components/hardware/libconti_radar.so"
    components {
        class_name : "ContiRadarCanbusComponent"
        config {
            name: "conti_radar_front"
            config_file_path:  "conf/hardware/radar/conti_radar/radar_front_conf.pb.txt"
        }
    }
    components {
        class_name : "ContiRadarCanbusComponent"
        config {
            name: "conti_radar_rear"
            config_file_path:  "conf/hardware/radar/conti_radar/radar_rear_conf.pb.txt"
        }
    }
}
