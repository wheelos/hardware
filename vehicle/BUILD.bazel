load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("@rules_pkg//pkg:install.bzl", "pkg_install")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes", "pkg_filegroup", "pkg_files", "strip_prefix")

package(default_visibility = ["//visibility:public"])

exports_files(["CPPLINT.cfg"])

alias(
    name = "component",
    actual = "//:libcanbus_component.so",
)

CANBUS_COPTS = ["-DMODULE_NAME=\\\"canbus\\\""]

cc_library(
    name = "canbus_component_lib",
    srcs = ["canbus_component.cc"],
    hdrs = ["canbus_component.h"],
    copts = CANBUS_COPTS,
    include_prefix = "modules/canbus",
    strip_include_prefix = "/",
    deps = [
        "//brands:vehicle_factory",
        "//common:canbus_common",
        "@com_github_gflags_gflags//:gflags",
        "@core//cyber",
        "@hardware.canbus//can_client",
        "@hardware.canbus//can_client:can_client_factory",
        "@hardware.canbus//can_comm:can_receiver",
        "@hardware.canbus//can_comm:can_sender",
        "@wheelos_common//modules/common/adapters:adapter_gflags",
        "@wheelos_common//modules/common/monitor_log",
        "@wheelos_common//modules/common/status",
        "@wheelos_msgs//wheelos_msgs/guardian_msgs:guardian_cc_proto",
    ],
    alwayslink = True,
)

cc_binary(
    name = "libcanbus_component.so",
    linkshared = True,
    linkstatic = False,
    deps = [
        ":canbus_component_lib",
    ],
)

pkg_files(
    name = "package_files_data",
    srcs = [":runtime_data"],
    attributes = pkg_attributes(mode = "0644"),
    prefix = "vehicle",
    strip_prefix = strip_prefix.from_root(""),
)

pkg_files(
    name = "package_files_libraries",
    srcs = [":libcanbus_component.so"],
    attributes = pkg_attributes(mode = "0755"),
    prefix = "vehicle/lib",
    strip_prefix = strip_prefix.from_root(""),
)

pkg_filegroup(
    name = "package_files",
    srcs = [
        ":package_files_data",
        ":package_files_libraries",
        ":pb_canbus",
    ],
)

pkg_install(
    name = "install_dir",
    srcs = [":package_files"],
    tags = ["manual"],
)

pkg_files(
    name = "pb_canbus_data",
    srcs = ["@wheelos_msgs//wheelos_msgs/chassis_msgs:chassis_py_pb2"],
    attributes = pkg_attributes(mode = "0644"),
    prefix = "modules/canbus",
    strip_prefix = strip_prefix.from_pkg(),
)

pkg_filegroup(
    name = "pb_canbus",
    srcs = [":pb_canbus_data"],
)

filegroup(
    name = "profile_runtime_data",
    srcs = glob(
        [
            "conf/**",
            "dag/*.dag",
            "launch/*.launch",
        ],
        exclude = ["conf/canbus_conf.pb.txt"],
    ),
)

filegroup(
    name = "runtime_data",
    srcs = glob([
        "conf/**",
        "dag/*.dag",
        "launch/*.launch",
    ]),
)

filegroup(
    name = "test_data",
    srcs = glob(["testdata/**"]),
)
