load("@core//runtime:install.bzl", "pkg_install")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes", "pkg_filegroup", "pkg_files", "strip_prefix")

package(default_visibility = ["//visibility:public"])

exports_files(["CPPLINT.cfg"])

alias(
    name = "component",
    actual = "//:libvideo_driver_component.so",
)

pkg_files(
    name = "package_files_data",
    srcs = [":runtime_files"],
    attributes = pkg_attributes(mode = "0644"),
    prefix = "drivers/addition_data/video",
    strip_prefix = strip_prefix.from_root(""),
)

pkg_files(
    name = "package_files_libraries",
    srcs = ["libvideo_driver_component.so"],
    attributes = pkg_attributes(mode = "0755"),
    prefix = "drivers/lib/video",
    strip_prefix = strip_prefix.from_root(""),
)

pkg_filegroup(
    name = "package_files",
    srcs = [
        ":package_files_data",
        ":package_files_libraries",
    ],
)

pkg_install(
    name = "install_dir",
    srcs = [":package_files"],
    tags = ["manual"],
)

filegroup(
    name = "runtime_files",
    srcs = glob([
        "conf/*.txt",
        "dag/*.dag",
        "launch/*.launch",
    ]),
)

cc_binary(
    name = "libvideo_driver_component.so",
    linkshared = True,
    linkstatic = False,
    deps = [":video_driver_component_lib"],
)

cc_library(
    name = "video_driver_component_lib",
    srcs = ["video_driver_component.cc"],
    hdrs = ["video_driver_component.h"],
    copts = ['-DMODULE_NAME=\\"video\\"'],
    include_prefix = "modules/drivers/video",
    strip_include_prefix = "/",
    deps = [
        "//:driver",
        "//:socket",
        "@core//cyber",
        "@wheelos_common//modules/common/util:util_tool",
    ],
    alwayslink = True,
)

cc_library(
    name = "driver",
    srcs = ["driver.cc"],
    hdrs = [
        "driver.h",
    ],
    include_prefix = "modules/drivers/video",
    strip_include_prefix = "/",
    deps = [
        ":socket",
        "//proto:video_h265cfg_cc_proto",
        "@core//cyber",
        "@wheelos_msgs//wheelos_msgs/sensor_msgs:sensor_image_cc_proto",
    ],
)

cc_library(
    name = "socket",
    srcs = ["socket_input.cc"],
    hdrs = [
        "socket_input.h",
    ],
    include_prefix = "modules/drivers/video",
    strip_include_prefix = "/",
    deps = [
        ":frame_assembler",
        "@core//cyber",
        "@wheelos_common//modules/common/util",
        "@wheelos_msgs//wheelos_msgs/basic_msgs:error_code_cc_proto",
        "@wheelos_msgs//wheelos_msgs/basic_msgs:header_cc_proto",
        "@wheelos_msgs//wheelos_msgs/sensor_msgs:sensor_image_cc_proto",
    ],
)

cc_library(
    name = "frame_assembler",
    srcs = ["frame_assembler.cc"],
    hdrs = [
        "frame_assembler.h",
        "input.h",
    ],
    include_prefix = "modules/drivers/video",
    strip_include_prefix = "/",
    deps = [
        "@core//cyber",
        "@wheelos_msgs//wheelos_msgs/sensor_msgs:sensor_image_cc_proto",
    ],
)

cc_test(
    name = "frame_assembler_test",
    size = "small",
    srcs = ["frame_assembler_test.cc"],
    deps = [
        ":frame_assembler",
        "@com_google_googletest//:gtest_main",
    ],
)
